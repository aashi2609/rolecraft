# Production environment variables
# Copy to .env.production and update with your production URLs

# Public API URL used by browser-side code
NEXT_PUBLIC_API_URL=https://your-api-domain.com

# WebSocket URL for real-time features
NEXT_PUBLIC_WS_URL=https://your-api-domain.com

# Next.js server-side API proxy target (rewrite destination)
API_PROXY_TARGET=https://your-api-domain.com
