# RoleCraft API — copy to .env and fill in values
#
# Neon (serverless Postgres) — use the POOLED connection string (-pooler in hostname)
# from the Neon Console → Connect. asyncpg needs the +asyncpg driver prefix.
# SSL: keep sslmode=require in the URL for documentation; the app strips it and
# passes connect_args={"ssl": "require"} for asyncpg compatibility.
#
# Format:
# DATABASE_URL=postgresql+asyncpg://[user]:[password]@[ep-xxx-pooler.region.aws.neon.tech]/[dbname]?sslmode=require
#
# Example (placeholder credentials — replace with your Neon Console values):
DATABASE_URL=postgresql+asyncpg://neondb_owner:YOUR_PASSWORD@ep-xxxxxxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
#
# Local Postgres (optional override while developing offline):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rolecraft
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
GCS_BUCKET_NAME=rolecraft-uploads
GCS_PROJECT_ID=
GROQ_API_KEY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENVIRONMENT=development
# Set STORAGE_BACKEND=local to save uploads under ./uploads instead of GCS
STORAGE_BACKEND=local
