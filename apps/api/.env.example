# RoleCraft API — copy to .env and fill in values
#
# Neon (serverless Postgres) — use the POOLED connection string (-pooler in hostname)
# from the Neon Console → Connect. asyncpg needs the +asyncpg driver prefix.
# SSL: keep sslmode=require in the URL for documentation; the app strips it and
# passes connect_args={"ssl": "require"} for asyncpg compatibility.
#
# Format:
# DATABASE_URL=postgresql+asyncpg://[user]:[password]@[ep-xxx-pooler.region.aws.neon.tech]/[dbname]?sslmode=require
#
# Example (placeholder credentials — replace with your Neon Console values):
DATABASE_URL=postgresql+asyncpg://neondb_owner:YOUR_PASSWORD@ep-xxxxxxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
#
# Local Postgres (optional override while developing offline):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rolecraft
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
GCS_BUCKET_NAME=rolecraft-uploads
GCS_PROJECT_ID=
GROQ_API_KEY=
# Set true to skip Groq and always use profile-based deterministic resumes (API-key backup).
# FORCE_DETERMINISTIC_RESUMES=false
# Optional overrides (defaults: openai/gpt-oss-20b)
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_ATS_MODEL=openai/gpt-oss-20b
# FITMENT_LLM_RATIONALES=true
# OpenAI-compatible embeddings (text-embedding-3-small, 1536 dims). Leave empty for mock vectors.
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_BASE=https://api.openai.com/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENVIRONMENT=development
# Set STORAGE_BACKEND=local to save uploads under ./uploads instead of GCS
STORAGE_BACKEND=local
# Rate limiting (see core/rate_limit.py RATE_LIMITS for values)
# RATE_LIMIT_ENABLED=true
# memory:// = single process only; use redis://host:6379/0 for multi-worker
# RATE_LIMIT_STORAGE_URI=memory://
# Set TRUSTED_PROXY=true only behind Cloud Run / Render / nginx so X-Forwarded-For is used
# TRUSTED_PROXY=false

# ── Email Configuration ──
# Provider: console (dev logs to stdout), smtp, or resend
EMAIL_PROVIDER=console
FRONTEND_URL=http://localhost:3000

# SMTP (if EMAIL_PROVIDER=smtp)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# Resend (if EMAIL_PROVIDER=resend)
# RESEND_API_KEY=

# ── Database safety (see docs/MIGRATIONS.md) ──
# Isolated DB for pytest / alembic rehearsal (local Postgres or a Neon *branch*).
# Must NOT be the primary endpoint ep-fragrant-salad-aybt4nuh (denylist in core/db_guard.py).
# TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/rolecraft_test
# Optional explicit primary snapshot for isolation checks (defaults to DATABASE_URL before rewrite)
# PRIMARY_DATABASE_URL=
# PRIMARY_ENDPOINT_ID=ep-fragrant-salad-aybt4nuh
# Never put ALLOW_PRIMARY_MIGRATIONS=1 in .env — set only for one explicit deploy command
# ALLOW_PRIMARY_MIGRATIONS=0
# ALLOW_DESTRUCTIVE_DOWNGRADE=0
# GCS_BACKUP_BUCKET=rolecraft-backups
