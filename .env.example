# Frontend environment variables
# Copy to .env.local for development. See .env.production.example for production.

# Browser-side API base URL. Leave unset in local dev to use the same-origin
# /backend proxy (Next.js rewrite -> FastAPI). REQUIRED for production builds
# (build fails if unset or pointing at localhost).
# NEXT_PUBLIC_API_URL=http://localhost:8000

# WebSocket base URL. Falls back to NEXT_PUBLIC_API_URL when unset.
# NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Server-side rewrite target for /backend/* (used by next.config.ts).
# Required for production builds.
# API_PROXY_TARGET=http://localhost:8000
