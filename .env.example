# Frontend environment variables
# Copy to .env.local for development. See .env.production.example for production.

# Browser-side API base URL. Leave unset in local dev to default to
# http://127.0.0.1:8000 (no /backend proxy exists under static export).
# REQUIRED for production builds (build fails if unset or pointing at localhost).
# NEXT_PUBLIC_API_URL=http://localhost:8000

# WebSocket base URL. Falls back to NEXT_PUBLIC_API_URL when unset.
# NEXT_PUBLIC_WS_URL=ws://localhost:8000
